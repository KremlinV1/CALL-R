# LiveKit Configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# OpenAI (for LLM and fallback TTS/STT)
OPENAI_API_KEY=sk-your-openai-key

# Cartesia (for high-quality TTS)
CARTESIA_API_KEY=your_cartesia_key

# Deepgram (for STT)
DEEPGRAM_API_KEY=your_deepgram_key

# ElevenLabs (optional alternative TTS)
ELEVENLABS_API_KEY=your_elevenlabs_key

# Backend API (for call status updates)
BACKEND_URL=http://localhost:3001
BACKEND_API_TOKEN=your_internal_api_token

# ─── Live Transfer Configuration ────────────────────────────────────
# Phone number that calls get transferred to when caller asks for a
# specialist or representative (e.g. your live agent's DID).
TRANSFER_SPECIALIST_NUMBER=+18005551234

# Optional: separate number for customer service representatives.
# Falls back to TRANSFER_SPECIALIST_NUMBER if not set.
TRANSFER_REPRESENTATIVE_NUMBER=+18005551234

# Outbound SIP trunk ID for dialing a specialist INTO the room
# (bridged transfer).  Leave blank to auto-fetch from the backend API
# using the organization's SkyTelecom / Custom SIP trunk.
OUTBOUND_SIP_TRUNK_ID=

# SkyTelecom SIP host used when dialing the specialist via SIP URI.
# Only needed if OUTBOUND_SIP_TRUNK_ID is set and you want to override
# the default host.
SKYTELECOM_SIP_HOST=connect.skytelecom.io:5060
